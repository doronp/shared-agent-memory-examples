@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""
+Script to reproduce the FilmOn plugin issue described in the bug report.
+"""
+
+import streamlink
+
+def test_filmon_urls():
+    """Test the FilmOn URLs mentioned in the issue."""
+    session = streamlink.Streamlink()
+    
+    # URLs that should work but currently don't
+    problematic_urls = [
+        'http://www.filmon.com/tv/channel-4',
+        'https://www.filmon.com/tv/channel-4',
+        'http://www.filmon.com/tv/channel-5', 
+        'https://www.filmon.com/tv/channel-5',
+    ]
+    
+    # URLs that currently work
+    working_urls = [
+        'https://www.filmon.com/tv/more4',
+    ]
+    
+    print("Testing FilmOn plugin URL handling...")
+    print("=" * 50)
+    
+    # Test problematic URLs
+    print("\nTesting problematic URLs (should work after fix):")
+    for url in problematic_urls:
+        try:
+            plugin = session.resolve_url(url)
+            print(f"✅ {url}: SUCCESS - {plugin.__class__.__name__}")
+        except streamlink.exceptions.NoPluginError:
+            print(f"❌ {url}: FAILED - NoPluginError (This is the bug!)")
+        except Exception as e:
+            print(f"⚠️  {url}: FAILED - {type(e).__name__}: {e}")
+    
+    # Test working URLs
+    print("\nTesting currently working URLs:")
+    for url in working_urls:
+        try:
+            plugin = session.resolve_url(url)
+            print(f"✅ {url}: SUCCESS - {plugin.__class__.__name__}")
+        except Exception as e:
+            print(f"❌ {url}: FAILED - {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    test_filmon_urls()
